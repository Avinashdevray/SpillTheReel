# SpillTheReel Backend — Environment Variables
# Copy this file to .env and fill in your actual keys:
#   cp .env.example .env

# OpenAI — https://platform.openai.com/api-keys
# Used by Cognee for entity extraction (gpt-4o-mini). ~$5 credits needed.
OPENAI_API_KEY=sk-your-openai-key

# Groq — https://console.groq.com/keys
# Used for free Whisper transcription
GROQ_API_KEY=gsk-your-groq-key

# Bluesmind — https://bluesminds.com (optional, OpenAI-compatible)
# Provides gpt-4o for Cognee entity extraction and Gemini vision fallback
BLUESMIND=sk-your-bluesmind-key

# Neo4j AuraDB — https://neo4j.com/cloud/aura-free/
# Create a free instance and paste credentials here
NEO4J_URI=neo4j+s://your-db-id.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
