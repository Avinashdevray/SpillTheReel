# ──────────────────────────────────────
# SpillTheReel – Environment Variables
# Copy this file to .env and fill in values.
# ──────────────────────────────────────

# General
APP_ENV=development
DEBUG=true

# Cognee – Graph Memory
COGNEE_API_KEY=your-cognee-api-key
COGNEE_LLM_PROVIDER=openai
COGNEE_LLM_MODEL=gpt-4o-mini

# OpenAI (used by Cognee for embeddings/LLM)
OPENAI_API_KEY=your-openai-api-key

# Optional: Override download directory
DOWNLOAD_DIR=./downloads
